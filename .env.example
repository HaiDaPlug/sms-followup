NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — server-only. Bypasses RLS; never expose to the browser.
# New-style key looks like sb_secret_...
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase — public (auth + browser client + the analytics read path).
# New-style key looks like sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy names. Still read as a fallback so the rename can ship before the
# values are swapped — see docs/supabase-key-rotation.md. Remove once the new
# names are set in every environment.
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase CLI only (db push / link). Not read by application code.
SUPABASE_DB_PASSWORD=

# Optional generic SMS provider adapter.
SMS_PROVIDER_WEBHOOK_URL=
SMS_PROVIDER_API_KEY=
TEST_SMS_TO=

# Preferred Sweden provider. If set, this is used before SMS_PROVIDER_WEBHOOK_URL.
SMS_PROVIDER=46elks
FORTYSIX_ELKS_USERNAME=
FORTYSIX_ELKS_PASSWORD=
FORTYSIX_ELKS_FROM=
# Virtual number that receives incoming SMS (used to validate the incoming webhook)
FORTYSIX_ELKS_VIRTUAL_NUMBER=+46766864658

# Optional shared secret for cron/webhooks.
# CRON_SECRET also has to be mirrored into the Supabase Vault as "cron_secret" —
# the scheduled-SMS worker is triggered by pg_cron, not Vercel cron.
# See docs/scheduled-sms-setup.md.
CRON_SECRET=
BOKADIREKT_WEBHOOK_SECRET=

# Required for 46elks delivery receipts. Without it no delivery URL is sent to
# the provider and the delivery webhook rejects every request, so reminder logs
# stay at "sent" and never advance to "delivered"/"failed".
SMS_DELIVERY_WEBHOOK_SECRET=

# After each send the provider's status API is polled until it reports
# delivered/failed or the budget below runs out, rather than assuming an
# accepted request means a delivered SMS. 46elks answers "created" immediately
# and only progresses once the operator responds, so a single lookup would learn
# nothing. Works even when the delivery webhook above is unreachable (e.g.
# localhost); a verdict that arrives later is picked up by that webhook.
# Set to "off" to skip verification entirely.
# SMS_VERIFY_DELIVERY=off

# Wall-clock budget per send for the polling above (default 6000 ms). The daily
# batch sends sequentially, so this is spent per patient — raise it only if
# confirmation matters more than batch duration.
# SMS_VERIFY_BUDGET_MS=6000
